#!/usr/bin/env bash
# Dev-mode launcher: runs SysDev Explorer straight from a checked-out copy of
# this repository, without requiring install.sh. Installed copies get their
# own launcher generated by install.sh instead.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

export PYTHONPATH="$PROJECT_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m sysdev_explorer "$@"
